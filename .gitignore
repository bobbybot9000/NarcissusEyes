# SwiftPM
.build/

# Local dev bundle produced by build_app.sh (the Xcode archive is the release path)
LookNice.app/

# Xcode
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcarchive

# macOS
.DS_Store

# Build scratch from make_dmg.sh / release.sh. site/LookNice.dmg is deliberately
# NOT ignored — Vercel deploys the site straight from this repo, so the download
# has to be committed or the button 404s.
/build/
.vercel
.env*
